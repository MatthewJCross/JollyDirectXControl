<Window x:Class="JollyDrumMachine.InstrumentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instrument Settings" Width="390" Height="370"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#101923" Foreground="#E7F0F5">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <DockPanel><TextBlock Text="Pan" /><TextBlock DockPanel.Dock="Right" Text="{Binding Pan, StringFormat={}{0:F2}}" /></DockPanel>
            <Slider Minimum="-1" Maximum="1" Value="{Binding Pan, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <DockPanel><TextBlock Text="Tune (semitones)" /><TextBlock DockPanel.Dock="Right" Text="{Binding Tune, StringFormat={}{0:F1}}" /></DockPanel>
            <Slider Minimum="-24" Maximum="24" Value="{Binding Tune, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <DockPanel><TextBlock Text="Attack (ms)" /><TextBlock DockPanel.Dock="Right" Text="{Binding Attack, StringFormat={}{0:F0}}" /></DockPanel>
            <Slider Minimum="0" Maximum="1000" Value="{Binding Attack, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <DockPanel><TextBlock Text="Decay (ms)" /><TextBlock DockPanel.Dock="Right" Text="{Binding Decay, StringFormat={}{0:F0}}" /></DockPanel>
            <Slider Minimum="1" Maximum="10000" Value="{Binding Decay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Grid.Row="5" Text="Changes are applied to subsequent hits and offline exports." TextWrapping="Wrap" Foreground="#91A6B6" VerticalAlignment="Top" Margin="0,4,0,12" />
        <Button Grid.Row="6" Content="CLOSE" Width="90" HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
</Window>
