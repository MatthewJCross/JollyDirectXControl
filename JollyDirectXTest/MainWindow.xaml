<Window x:Class="JollyDirectXTestCtrl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="clr-namespace:Jolly2DEngine.Rendering.DirectX;assembly=Jolly2DEngine"
        Title="Jolly DirectX Physics Test"
        Width="1320"
        Height="900"
        MinWidth="1200"
        MinHeight="800"
        Background="#202020"
        Foreground="White">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1024" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="1024"
                Height="768"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Black"
                BorderBrush="#505050"
                BorderThickness="1">

            <dx:DirectXControl x:Name="DirectXControl"
                               Width="1024"
                               Height="768"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />
        </Border>

        <ScrollViewer Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <TextBlock Text="PHYSICS TEST"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,15" />

                <TextBlock Text="RENDER"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="FpsText"
                           Text="Render FPS: 0.0"
                           Margin="0,0,0,3" />

                <TextBlock x:Name="FrameTimeText"
                           Text="Render Time: 0.0 ms"
                           Margin="0,0,0,10" />

                <TextBlock Text="GAME LOOP"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="GameFpsText"
                           Text="Game Loop FPS: 0.0"
                           Margin="0,0,0,3" />

                <TextBlock x:Name="GameFrameTimeText"
                           Text="Game Time: 0.0 ms"
                           Margin="0,0,0,10" />

                <Separator Margin="0,0,0,10" />

                <TextBlock Text="PLAYER"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="PlayerPositionText"
                           Text="Position: 0.0, 0.0"
                           Margin="0,0,0,3" />

                <TextBlock x:Name="PlayerVelocityText"
                           Text="Velocity: 0.0, 0.0"
                           Margin="0,0,0,3" />

                <TextBlock x:Name="PlayerGroundedText"
                           Text="Grounded: False"
                           Margin="0,0,0,3" />

                <TextBlock x:Name="PhysicsObjectsText"
                           Text="Physics Objects: 0"
                           Margin="0,0,0,10" />

                <Separator Margin="0,0,0,10" />

                <TextBlock Text="CAMERA"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="WorldPositionText"
                           Text="Camera: 0.0, 0.0&#10;Zoom: 1.00&#10;Rotation: 0.0°"
                           Margin="0,0,0,10" />

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="X:"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="CameraXTextBox"
                             Grid.Column="1"
                             Text="800.0"
                             Margin="5,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Y:"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="CameraYTextBox"
                             Grid.Column="1"
                             Text="500.0"
                             Margin="5,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Zoom:"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="CameraZoomTextBox"
                             Grid.Column="1"
                             Text="1.00"
                             Margin="5,0,0,0" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Rot:"
                               VerticalAlignment="Center" />

                    <TextBox x:Name="CameraRotationTextBox"
                             Grid.Column="1"
                             Text="0.0"
                             Margin="5,0,0,0" />
                </Grid>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <Button x:Name="ApplyCameraButton"
                            Content="Apply"
                            Width="75"
                            Height="28"
                            Click="ApplyCameraButton_Click"
                            Margin="0,0,5,0" />

                    <Button x:Name="ReadCameraButton"
                            Content="Read"
                            Width="75"
                            Height="28"
                            Click="ReadCameraButton_Click" />
                </StackPanel>

                <Separator Margin="0,0,0,10" />

                <TextBlock Text="MOUSE"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="MouseWorldXText"
                           Text="World X: 0.0"
                           Margin="0,0,0,3" />

                <TextBlock x:Name="MouseWorldYText"
                           Text="World Y: 0.0"
                           Margin="0,0,0,10" />

                <Separator Margin="0,0,0,10" />

                <TextBlock Text="CONTROLS"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock Text="A / D or ← / →  Move"
                           Margin="0,0,0,3" />

                <TextBlock Text="SPACE  Jump" Margin="0,0,0,3" />
                <TextBlock Text="R  Reset player" Margin="0,0,0,10" />
                <Separator Margin="0,0,0,10" />
                <TextBlock Text="PHYSICS" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="Gravity: 980" Margin="0,0,0,3" />
                <TextBlock Text="Move Speed: 300" Margin="0,0,0,3" />
                <TextBlock Text="Jump Velocity: 450" Margin="0,0,0,3" />
                <TextBlock Text="World: 2000 × 1200" Margin="0,0,0,10" />
                <TextBlock x:Name="PhysicsDebugText" Text="Debug: ON (F3)" Margin="0,0,0,10" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>